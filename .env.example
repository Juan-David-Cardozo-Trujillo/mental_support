# ==============================================================================
# MindBridge — Student Mental Health Support Platform
# Environment Configuration Template
#
# USAGE: Copy this file to .env and fill in actual values.
#        Never commit the .env file to version control.
#        Use AWS Secrets Manager / GitHub Secrets in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# AUTH SERVICE DATABASE
# Dedicated PostgreSQL instance (port 5432 locally, separate RDS in prod)
# ------------------------------------------------------------------------------
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
DATABASE_AUTH_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_service

# ------------------------------------------------------------------------------
# PLATFORM DATABASE
# Separate PostgreSQL instance (port 5433 locally, separate RDS in prod)
# CRITICAL: Never share this instance with auth_service
# ------------------------------------------------------------------------------
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
DATABASE_PLATFORM_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/platform_db

# ------------------------------------------------------------------------------
# REDIS
# Used for: session cache, rate limiting, Celery broker & result backend
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0
CELERY_BROKER_URL=redis://:redispassword@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redispassword@localhost:6379/2

# ------------------------------------------------------------------------------
# JWT CONFIGURATION
# REPLACE JWT_SECRET with 256-bit (32-byte) cryptographically random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_256BIT_SECRET_USE_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ------------------------------------------------------------------------------
# AES-256 ENCRYPTION KEY
# Used for encrypting chat messages at rest.
# REPLACE with 32-byte (64-char hex) cryptographically random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production: stored ONLY in AWS Secrets Manager — not here.
# ------------------------------------------------------------------------------
AES_KEY=REPLACE_WITH_64_HEX_CHAR_AES256_KEY_EXAMPLE_aabbccdd11223344aabbccdd11223344

# ------------------------------------------------------------------------------
# SSO CONFIGURATION (OAuth 2.0 / OIDC)
# In dev: points to mock_sso container
# In prod: replace with real university identity provider URLs
# ------------------------------------------------------------------------------
SSO_CLIENT_ID=mental-health-platform
SSO_CLIENT_SECRET=REPLACE_WITH_SSO_CLIENT_SECRET
SSO_AUTHORIZATION_URL=http://localhost:8080/authorize
SSO_TOKEN_URL=http://localhost:8080/token
SSO_USERINFO_URL=http://localhost:8080/userinfo
SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
SSO_SCOPE=openid profile email role

# ------------------------------------------------------------------------------
# AWS CREDENTIALS (production only)
# Use IAM roles / instance profiles in ECS — do NOT set these in production
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY

# AWS Secrets Manager ARN for the AES-256 encryption key
ENCRYPTION_KEY_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:mental-health/aes-key-XXXXXX

# AWS Secrets Manager ARN for JWT secret
JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:mental-health/jwt-secret-XXXXXX

# S3 bucket for exports, reports
AWS_S3_BUCKET=mindbridge-platform-files-REPLACE

# ------------------------------------------------------------------------------
# EMAIL / SMTP (for notifications, appointment reminders)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@mindbridge.io
SMTP_FROM_NAME=MindBridge Platform
SMTP_TLS=true

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# These tune platform behavior — match the platform specification exactly
# ------------------------------------------------------------------------------

# Peer counselor burnout detection threshold (sessions per week)
BURNOUT_THRESHOLD=20

# Minimum passing score for peer counselor certification training (%)
TRAINING_PASS_SCORE=70

# Max peer-initiated chat sessions per day per peer counselor
MAX_DAILY_SESSIONS=3

# Number of reports to auto-suspend a peer counselor
REPORT_SUSPENSION_THRESHOLD=3

# Time window for counting reports (days)
REPORT_WINDOW_DAYS=7

# Non-flagged message purge delay after session close (hours)
MESSAGE_PURGE_HOURS=24

# Flagged message retention period (days)
FLAGGED_RETENTION_DAYS=90

# Session inactivity timeout (minutes)
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Wait-queue max size before alert
QUEUE_MAX_SIZE=20

# Average wait time alert threshold (minutes)
WAIT_TIME_ALERT_MINUTES=15

# Min peer counselors per 100 students
PEER_RATIO_MIN=5

# ------------------------------------------------------------------------------
# CORS & FRONTEND
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# ENVIRONMENT
# Values: development | staging | production
# ------------------------------------------------------------------------------
ENV=development
DEBUG=true
